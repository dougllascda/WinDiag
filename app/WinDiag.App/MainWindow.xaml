<Window x:Class="WinDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDiag" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontSize="13" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{StaticResource WinDiagLogo}" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WinDiag" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="ModeHost" Margin="0,0,12,0" VerticalAlignment="Center" IsTabStop="False" />
                    <Button x:Name="ExportButton" IsEnabled="False" Click="Export_Click"
                            Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                            TabIndex="0" />
                    <Button x:Name="ReloadButton" Click="Reload_Click" Margin="0,0,8,0" TabIndex="1" />
                    <Button x:Name="ThemeButton" Content="&#xE771;" Style="{StaticResource IconButton}" Click="Theme_Click"
                            Margin="0,0,4,0" />
                    <Button x:Name="AboutButton" Content="&#xE946;" Style="{StaticResource IconButton}" Click="About_Click"
                            />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" TabIndex="2" />

        <!-- Barra de status -->
        <Border Grid.Row="2" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AdminText" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
