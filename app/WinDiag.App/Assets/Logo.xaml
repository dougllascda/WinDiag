<!--
  Marca do WinDiag: quadrado arredondado azul-marinho com contorno claro, moldura de chip (com pinos)
  e uma linha de pulso que forma a letra W. Desenho em grade 64 x 64.
  Esta é a ÚNICA fonte do desenho: o cabeçalho e a janela "Sobre" usam o DrawingImage "WinDiagLogo",
  e os scripts tools\make-icon.ps1 e tools\make-social-preview.ps1 renderizam este mesmo arquivo para
  gerar Assets\WinDiag.ico, docs\assets\logo.png e docs\assets\social-preview.png.
  "WinDiagLogoSmall" é a versão simplificada (só o W, traço grosso) usada nos tamanhos de 16 a 24 px do ícone,
  em que a moldura e os pinos ficariam ilegíveis.
  Nenhuma referência a recursos de tema aqui (os scripts carregam o arquivo isoladamente).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fundo: azul-marinho, um pouco mais claro no topo para não sumir em barra de tarefas escura. -->
    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14356B" Offset="0" />
        <GradientStop Color="#0A1A3C" Offset="0.55" />
        <GradientStop Color="#060E22" Offset="1" />
    </LinearGradientBrush>

    <!-- Traço principal: ciano à esquerda, azul à direita. -->
    <LinearGradientBrush x:Key="LogoStroke" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2EE6F2" Offset="0" />
        <GradientStop Color="#3F8CFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Contorno do quadrado: garante a borda visível em fundo preto ou cinza escuro. -->
    <LinearGradientBrush x:Key="LogoRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8FB4F0" Offset="0" />
        <GradientStop Color="#4B6FB3" Offset="1" />
    </LinearGradientBrush>

    <!-- Pinos do chip: 4 em cima, 4 embaixo, 2 de cada lado (a linha de pulso ocupa o meio das laterais). -->
    <GeometryGroup x:Key="LogoPins">
        <PathGeometry Figures="M22,10.5 V13.5 M28.7,10.5 V13.5 M35.3,10.5 V13.5 M42,10.5 V13.5 M22,50.5 V53.5 M28.7,50.5 V53.5 M35.3,50.5 V53.5 M42,50.5 V53.5 M8.5,23 H11.5 M8.5,41 H11.5 M52.5,23 H55.5 M52.5,41 H55.5" />
    </GeometryGroup>

    <!-- Linha de pulso em forma de W (versão completa: atravessa a moldura). -->
    <PathGeometry x:Key="LogoPulse" Figures="M8.5,32 H18.5 L23.5,21.5 L28.5,42.5 L32,31 L35.5,42.5 L40.5,21.5 L45.5,32 H55.5" />

    <!-- Linha de pulso em forma de W (versão simplificada: maior, para 16 a 24 px). -->
    <PathGeometry x:Key="LogoPulseSmall" Figures="M8.5,32 H13 L19,16.5 L25.5,46.5 L32,24 L38.5,46.5 L45,16.5 L51,32 H55.5" />

    <DrawingImage x:Key="WinDiagLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64" />
                </DrawingGroup.ClipGeometry>

                <!-- Base: quadrado arredondado com gradiente e contorno. -->
                <GeometryDrawing Brush="{StaticResource LogoGradient}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoRim}" Thickness="1.3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0.65,0.65,62.7,62.7" RadiusX="14.5" RadiusY="14.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Pinos. -->
                <GeometryDrawing Geometry="{StaticResource LogoPins}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#D93FB6F7" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Moldura do chip. -->
                <GeometryDrawing Brush="#14309AE8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoStroke}" Thickness="2.2" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="13,15,38,34" RadiusX="6.5" RadiusY="6.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Brilho da linha de pulso: dois traços largos e translúcidos por baixo. -->
                <GeometryDrawing Geometry="{StaticResource LogoPulse}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1F2EE6F2" Thickness="8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource LogoPulse}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#332EE6F2" Thickness="5.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Linha de pulso em W. -->
                <GeometryDrawing Geometry="{StaticResource LogoPulse}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoStroke}" Thickness="3.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="WinDiagLogoSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64" />
                </DrawingGroup.ClipGeometry>

                <!-- Base com contorno mais grosso, para sobrar ao menos meio pixel em 16 px. -->
                <GeometryDrawing Brush="{StaticResource LogoGradient}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoRim}" Thickness="2.6" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1.3,1.3,61.4,61.4" RadiusX="14" RadiusY="14" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Só o W, com traço grosso. -->
                <GeometryDrawing Geometry="{StaticResource LogoPulseSmall}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoStroke}" Thickness="5.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
