<!--
  Marca do WinDiag: quadrado arredondado com gradiente azul, chip estilizado (corpo + pinos)
  e uma linha de pulso (monitoramento) sobre o chip. Desenho em grade 64 x 64.
  Esta é a ÚNICA fonte do desenho: a janela "Sobre" usa o DrawingImage "WinDiagLogo" e o script
  tools\make-icon.ps1 renderiza este mesmo arquivo para gerar Assets\WinDiag.ico.
  Nenhuma referência a recursos de tema aqui (o script carrega o arquivo isoladamente).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5DB1FF" Offset="0" />
        <GradientStop Color="#1D5FD8" Offset="1" />
    </LinearGradientBrush>

    <!-- Pinos do chip (4 por lado). -->
    <GeometryGroup x:Key="LogoPins">
        <PathGeometry Figures="M24,8.5 V16 M32,8.5 V16 M40,8.5 V16 M24,48 V55.5 M32,48 V55.5 M40,48 V55.5 M8.5,24 H16 M8.5,32 H16 M8.5,40 H16 M48,24 H55.5 M48,32 H55.5 M48,40 H55.5" />
    </GeometryGroup>

    <DrawingImage x:Key="WinDiagLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64" />
                </DrawingGroup.ClipGeometry>

                <!-- Base: quadrado arredondado com gradiente. -->
                <GeometryDrawing Brush="{StaticResource LogoGradient}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="15" RadiusY="15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Pinos. -->
                <GeometryDrawing Geometry="{StaticResource LogoPins}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E6FFFFFF" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Corpo do chip. -->
                <GeometryDrawing Brush="#26FFFFFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2.6" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16,16,32,32" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Linha de pulso. -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20.5,33 H26 L29.5,24.5 L34.5,41 L38,31 H43.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
